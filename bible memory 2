      'ㄱ', 'ㄲ', 'ㄴ', 'ㄷ', 'ㄸ', 'ㄹ', 'ㅁ', 'ㅂ', 'ㅃ', 'ㅅ', 
      'ㅆ', 'ㅇ', 'ㅈ', 'ㅉ', 'ㅊ', 'ㅋ', 'ㅌ', 'ㅍ', 'ㅎ'
    ];

    function getKoreanInitial(char) {
      const code = char.charCodeAt(0) - 0xAC00;
      if (code > -1 && code < 11172) {
        return CHOSUNG_LIST[Math.floor(code / 588)];
      }
      return char;
    }

    function toInitialString(text) {
