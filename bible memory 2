    function renderVerseText() {
      const data = BIBLE_PLAN[currentDayIndex];
      const rawText = data.text;

      modeHelperEl.classList.add('hidden');
      typingContainer.classList.add('hidden');

      if (currentMode === 'full') {
        verseContentEl.innerHTML = rawText.replace(/\n/g, '<br><br>');
      } else if (currentMode === 'typing') {
        // Typing mode: show reference and empty/reset typing area
        verseContentEl.innerHTML = `<span class="text-sm font-semibold text-slate-500 block mb-2">[원문 말씀 읽기]</span>` + rawText.replace(/\n/g, '<br>');
        typingContainer.classList.remove('hidden');
        typingInput.value = '';
        handleTypingInput();
      } else if (currentMode === 'initial') {
        const initialText = toInitialString(rawText);
        verseContentEl.innerHTML = `<span class="tracking-widest font-mono text-slate-700 font-medium">${initialText.replace(/\n/g, '<br><br>')}</span>`;
      } else if (currentMode === 'blank') {
        modeHelperEl.classList.remove('hidden');
        const words = rawText.split(/(\s+)/);
        let wordCounter = 0;
        const html = words.map(chunk => {
          if (/^\s+$/.test(chunk)) return chunk.replace(/\n/g, '<br>');
          wordCounter++;
          if (wordCounter % 2 === 0 && chunk.length > 1) {
            return `<span class="blank-word inline-block bg-amber-100 text-amber-100 hover:text-slate-900 border-b-2 border-amber-400 px-1 rounded cursor-pointer transition selection:bg-transparent" onclick="this.classList.toggle('text-slate-900'); this.classList.toggle('text-amber-100');">${chunk}</span>`;
          }
          return chunk;
        }).join('');
        verseContentEl.innerHTML = html;
      } else if (currentMode === 'blind') {
        verseContentEl.innerHTML = `
          <div class="py-10 text-center flex flex-col items-center justify-center cursor-pointer group" onclick="setMode('full')">
            <div class="w-14 h-14 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-2xl mb-3 group-hover:scale-110 transition">
              <i class="fa-solid fa-eye-slash"></i>
            </div>
            <p class="font-bold text-slate-700 text-base mb-1">말씀이 숨겨져 있습니다</p>
            <p class="text-xs text-slate-400">마음속으로 암송해본 후 여기를 터치해 정답을 확인하세요!</p>
          </div>
        `;
      }
    }

    window.setMode = function(mode) {
      currentMode = mode;
      document.querySelectorAll('.mode-tab').forEach(tab => {
        if (tab.dataset.mode === mode) {
          tab.className = 'mode-tab px-3 py-1.5 rounded-xl bg-slate-900 text-white transition active:scale-95 font-bold shadow-sm';
        } else {
          tab.className = 'mode-tab px-3 py-1.5 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 transition active:scale-95';
        }
      });
      renderVerseText();
    };

    function renderDayView() {
      const data = BIBLE_PLAN[currentDayIndex];
      const isToday = currentDayIndex === todayOfficialIndex;
      const isDone = !!myCompletedDays[data.day];

      verseThemeBadgeEl.textContent = data.theme;
      verseRefEl.textContent = data.ref;
      currentDateDisplayEl.textContent = `${data.dateStr} · Day ${data.day}`;
      dateRangeInfoEl.textContent = `${data.dateStr} 암송 구절`;

      if (isToday) {
        badgeTodayEl.classList.remove('hidden');
        badgeTodayEl.innerHTML = `<i class="fa-solid fa-sparkles text-amber-500"></i> 오늘의 암송구절!`;
        badgeTodayEl.className = "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800 mb-0.5 pulse-glow";
      } else {
        badgeTodayEl.classList.remove('hidden');
        badgeTodayEl.className = "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-600 mb-0.5";
        badgeTodayEl.innerHTML = `Day ${data.day} of ${TOTAL_DAYS}`;
      }

      if (isDone) {
        toggleCompleteBtn.innerHTML = `
          <i class="fa-solid fa-circle-check text-lg text-emerald-500"></i>
          <span id="toggleCompleteBtnText" class="text-emerald-700 font-bold">${myNickname}님 암송 완료됨</span>
        `;
        toggleCompleteBtn.className = "w-full sm:w-auto px-5 py-2.5 rounded-2xl font-bold text-sm flex items-center justify-center gap-2 transition-all shadow-sm active:scale-95 bg-emerald-50 border border-emerald-300 text-emerald-800";
      } else {
        toggleCompleteBtn.innerHTML = `
          <i class="fa-regular fa-circle-check text-lg text-slate-400"></i>
          <span id="toggleCompleteBtnText">${myNickname}님 암송 완료하기</span>
        `;
        toggleCompleteBtn.className = "w-full sm:w-auto px-5 py-2.5 rounded-2xl font-bold text-sm flex items-center justify-center gap-2 transition-all shadow-sm active:scale-95 bg-white border border-slate-300 text-slate-700 hover:border-emerald-500 hover:text-emerald-700";
      }

      renderVerseText();
      renderScheduleGrid();
      updateProgress();
    }

    function showToast(message) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      toastMsg.textContent = message;
      toast.classList.remove('opacity-0', 'translate-y-3');
      toast.classList.add('opacity-100', 'translate-y-0');

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-3');
        toast.classList.remove('opacity-100', 'translate-y-0');
      }, 2000);
    }

    function copyVerse() {
      const data = BIBLE_PLAN[currentDayIndex];
      const copyText = `[말씀 암송 48일 - Day ${data.day}]\n${data.ref}\n\n${data.text}`;
      
      const textArea = document.createElement("textarea");
      textArea.value = copyText;
      document.body.appendChild(textArea);
      textArea.select();
      try {
        document.execCommand('copy');
        showToast("구절이 클립보드에 복사되었습니다!");
      } catch (err) {
        showToast("복사에 실패했습니다.");
      }
      document.body.removeChild(textArea);
    }

    function speakVerse() {
      const data = BIBLE_PLAN[currentDayIndex];
      if (!('speechSynthesis' in window)) {
        showToast("음성 읽기를 지원하지 않는 브라우저입니다.");
        return;
      }
      window.speechSynthesis.cancel();
      const speakText = `${data.ref}. ${data.text}`;
      const utterance = new SpeechSynthesisUtterance(speakText);
      utterance.lang = 'ko-KR';
      utterance.rate = 0.88;
      window.speechSynthesis.speak(utterance);
      showToast("말씀을 낭독합니다.");
    }

    // Navigation & Action listeners
    document.getElementById('prevDayBtn').addEventListener('click', () => {
      if (currentDayIndex > 0) {
        currentDayIndex--;
        renderDayView();
      } else {
        showToast("첫 번째 구절입니다.");
      }
    });

    document.getElementById('nextDayBtn').addEventListener('click', () => {
      if (currentDayIndex < TOTAL_DAYS - 1) {
        currentDayIndex++;
        renderDayView();
      } else {
        showToast("마지막 암송 구절입니다!");
      }
    });

    document.getElementById('todayJumpBtn').addEventListener('click', () => {
      currentDayIndex = todayOfficialIndex;
      renderDayView();
      showToast("오늘의 암송구절로 이동했습니다!");
    });

    document.getElementById('toggleListBtn').addEventListener('click', () => {
      allDaysContainer.scrollIntoView({ behavior: 'smooth' });
    });

    document.querySelectorAll('.mode-tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        window.setMode(e.currentTarget.dataset.mode);
      });
    });

    document.getElementById('copyBtn').addEventListener('click', copyVerse);
    document.getElementById('speakBtn').addEventListener('click', speakVerse);

    toggleCompleteBtn.addEventListener('click', async () => {
      const currentDay = BIBLE_PLAN[currentDayIndex].day;
      if (myCompletedDays[currentDay]) {
        delete myCompletedDays[currentDay];
        showToast(`Day ${currentDay} 암송 완료를 취소했습니다.`);
      } else {
        myCompletedDays[currentDay] = true;
        showToast(`Day ${currentDay} 암송 완료! 은혜로운 하루 되세요 🙏`);
      }
      renderDayView();
      await syncMyProgressToCloud();
    });

    // Entrance Gate handlers
    function handleEntrance() {
      const enteredName = entranceNameInput.value.trim();
      if (!enteredName) {
        entranceErrorMsg.classList.remove('hidden');
        entranceNameInput.focus();
        return;
      }
      entranceErrorMsg.classList.add('hidden');
      myNickname = enteredName;
      localStorage.setItem('bible_memorize_user_nickname', enteredName);
      updateNicknameDisplays();
      syncMyProgressToCloud();

      // Smooth hide entrance screen
      entranceScreen.classList.add('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        entranceScreen.classList.add('hidden');
        showToast(`${myNickname}님, 환영합니다! 오늘 암송을 시작하세요.`);
      }, 500);
    }

    enterChallengeBtn.addEventListener('click', handleEntrance);
    entranceNameInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        handleEntrance();
      }
    });

    profileEditBtn.addEventListener('click', () => {
      nicknameInput.value = myNickname;
      nicknameModal.classList.remove('hidden');
      nicknameInput.focus();
    });

    // Modal Control Listeners
    openCommunityBtn.addEventListener('click', () => {
      communityModal.classList.remove('hidden');
    });
    quickViewCommBtn.addEventListener('click', () => {
      communityModal.classList.remove('hidden');
    });
    closeCommunityModal.addEventListener('click', () => {
      communityModal.classList.add('hidden');
    });
    closeCommunityModalBottom.addEventListener('click', () => {
      communityModal.classList.add('hidden');
    });

    changeNicknameBtn.addEventListener('click', () => {
      nicknameInput.value = myNickname;
      nicknameModal.classList.remove('hidden');
      nicknameInput.focus();
    });

    cancelNicknameBtn.addEventListener('click', () => {
      nicknameModal.classList.add('hidden');
    });

    saveNicknameBtn.addEventListener('click', async () => {
      const val = nicknameInput.value.trim();
      if (!val) {
        showToast("닉네임을 입력해주세요.");
        return;
      }
      myNickname = val;
      localStorage.setItem('bible_memorize_user_nickname', val);
      updateNicknameDisplays();
      nicknameModal.classList.add('hidden');
      showToast("닉네임이 저장되었습니다.");
      await syncMyProgressToCloud();
    });

    // Booting up application
    window.addEventListener('DOMContentLoaded', () => {
      renderDayView();
      initAuthAndFirestore();
      
      // Auto focus on name input on entrance screen
      setTimeout(() => {
        entranceNameInput.focus();
      }, 300);
    });
  </script>
</body>
</html>
