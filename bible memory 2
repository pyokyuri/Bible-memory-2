    function handleTypingInput() {
      const data = BIBLE_PLAN[currentDayIndex];
      const rawTarget = data.text;
      const userInput = typingInput.value;

      // Clean string for loose comparison (whitespace normalized)
      const cleanTarget = rawTarget.replace(/\s+/g, ' ').trim();
      const cleanUser = userInput.replace(/\s+/g, ' ').trim();

      // Realtime visual feedback
      let feedbackHtml = '';
      let matchCount = 0;
      const maxLen = Math.max(cleanTarget.length, cleanUser.length);

      for (let i = 0; i < cleanTarget.length; i++) {
        const targetChar = cleanTarget[i];
        const userChar = cleanUser[i];

        if (userChar === undefined) {
          feedbackHtml += `<span class="text-slate-400">${targetChar}</span>`;
        } else if (userChar === targetChar) {
          matchCount++;
          feedbackHtml += `<span class="text-emerald-600 font-semibold bg-emerald-50">${targetChar}</span>`;
        } else {
          feedbackHtml += `<span class="text-rose-600 font-bold bg-rose-50 underline">${userChar}</span>`;
        }
      }

      typingFeedback.innerHTML = feedbackHtml || '입력을 시작하면 대조가 표시됩니다...';

      // Accuracy calculation
      const acc = cleanTarget.length > 0 ? Math.round((matchCount / cleanTarget.length) * 100) : 0;
      typingAccuracy.textContent = `정확도 ${acc}%`;

      if (acc === 100 && cleanUser === cleanTarget) {
        typingMatchMessage.classList.remove('hidden');
        typingAccuracy.className = "font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-md";
        // Auto prompt completion
        if (!myCompletedDays[data.day]) {
          toggleCompleteBtn.classList.add('ring-4', 'ring-emerald-400', 'animate-bounce');
        }
      } else {
        typingMatchMessage.classList.add('hidden');
        typingAccuracy.className = "font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-md";
        toggleCompleteBtn.classList.remove('ring-4', 'ring-emerald-400', 'animate-bounce');
      }
    }

