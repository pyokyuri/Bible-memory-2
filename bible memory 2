    // Save current user's progress to cloud
    async function syncMyProgressToCloud() {
      if (!currentUser) return;
      try {
        const completedArr = Object.keys(myCompletedDays)
          .filter(k => myCompletedDays[k])
          .map(Number)
          .sort((a, b) => a - b);

        const lastDayNum = completedArr.length > 0 ? Math.max(...completedArr) : 0;
        const lastVerseObj = BIBLE_PLAN.find(p => p.day === lastDayNum);
        const lastRef = lastVerseObj ? `${lastVerseObj.ref} (Day ${lastDayNum})` : '시작 전';

        const userDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'members', currentUser.uid);
        await setDoc(userDocRef, {
          userId: currentUser.uid,
          nickname: myNickname,
          completedDays: completedArr,
          completedCount: completedArr.length,
          progressPercent: Math.round((completedArr.length / TOTAL_DAYS) * 100),
          lastCompletedDay: lastDayNum,
          lastVerseRef: lastRef,
          updatedAt: Date.now()
        }, { merge: true });
      } catch (e) {
        console.error("Cloud save failed:", e);
      }
    }

